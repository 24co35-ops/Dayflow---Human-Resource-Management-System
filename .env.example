# Dayflow local development
FASTAPI_ENV=development
PROJECT_NAME="Dayflow HRMS"
SECRET_KEY=replace-with-a-long-random-value
FIRST_SUPERUSER=admin@example.com
FIRST_SUPERUSER_PASSWORD=replace-me
FRONTEND_HOST=http://localhost:5173

# Supabase: leave blank to use the offline seeded demo adapter.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key

# FastAPI template compatibility. Use the Supabase Postgres connection string when
# running the SQLModel-backed reference routes; never commit a real password.
DATABASE_URL=postgresql://postgres:replace-me@localhost:5432/app

# Dayflow API adapter. Demo mode requires explicit actor headers and is not production auth.
DAYFLOW_DEMO_MODE=true
DAYFLOW_PERSIST_DEMO_STATE=true
DAYFLOW_STATE_FILE=/tmp/dayflow-demo-state.json
