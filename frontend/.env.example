# Frontend API origin. The Dayflow service appends /api/v1/dayflow.
VITE_API_URL=http://localhost:8000

# Set true to use FastAPI-backed Dayflow workflows; false keeps the offline fixture UI.
VITE_DAYFLOW_API_ENABLED=true

# Optional browser-safe Supabase configuration. Never place the service-role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
